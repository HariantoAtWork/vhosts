services:
  vhosts:
    image: harianto/vhosts:latest
    container_name: vhosts
    restart: unless-stopped
    ports:
      - "80:80"
      - "1080:1080"
    volumes:
      - ./data/vhosts:/var/lib/vhosts
      - ./config/vhosts:/etc/vhosts
    environment:
      - TZ=${TZ:-UTC}
      - NITRO_HOST=0.0.0.0
      - NITRO_PORT=80
      - VHOSTS_CONTROL_PORT=${VHOSTS_CONTROL_PORT:-1080}
      - VHOSTS_CONTROL_TLS_PORT=${VHOSTS_CONTROL_TLS_PORT:-1443}
      - NUXT_APP_ROOT=${NUXT_APP_ROOT:-/var/lib/vhosts}
      - NUXT_APP_CONFIG=${NUXT_APP_CONFIG:-/etc/vhosts}
