# Local app data root → runtimeConfig.appRoot (default: .data)
NUXT_APP_ROOT=.data

# Local app config root → runtimeConfig.appConfig (default: .config)
NUXT_APP_CONFIG=.config

# Optional brand/title on edge default pages (localhost:80), not site placeholders
# NUXT_EDGE_TITLE=vhosts-prod

# Edge static sites (default 80 in Docker; Nuxt dev uses 3000)
# NITRO_PORT=80

# Management UI + /api (default 1080)
VHOSTS_CONTROL_PORT=1080

# Reserved for future control HTTPS
VHOSTS_CONTROL_TLS_PORT=1443
